#include "resource.h"
#include <winver.h>

IDI_APP_ICON ICON "..\\assets\\app_icon.ico"
IDR_EMBEDDED_ZIP RCDATA "..\\assets.zip"

// Embed Application Manifest
1 24 "app.manifest"

// Embed Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Gunwant Bhambra"
            VALUE "FileDescription",  "XCODING C++ Student Interactive IDE"
            VALUE "FileVersion",      "1.0.1.0"
            VALUE "InternalName",     "XCODING"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Gunwant Bhambra"
            VALUE "OriginalFilename", "XCODING.exe"
            VALUE "ProductName",      "XCODING"
            VALUE "ProductVersion",   "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
